<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="5.0">

    <context-param>
        <param-name>controllerPackage</param-name>
        <param-value>controllers</param-value>
    </context-param>

    <!-- 1. Spring d'abord -->
    <listener>
        <listener-class>listener.AppListener</listener-class>
    </listener>

    <!-- 2. Scan controllers ensuite -->
    <listener>
        <listener-class>mg.itu.listener.FrontControllerListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>FrontController</servlet-name>
        <servlet-class>mg.itu.FrontControllerServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrontController</servlet-name>
        <url-pattern>/app/*</url-pattern>
    </servlet-mapping>

</web-app>